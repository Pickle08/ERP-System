# Kosongkan untuk memakai proxy Vite (/api). Saat deploy, isi URL backend, misal https://api.contoh.com/api
VITE_API_URL=

# Tampilkan tombol akun demo di halaman login (untuk presentasi portfolio)
VITE_SHOW_DEMO_ACCOUNTS=true

# Identitas perusahaan di dokumen cetak (invoice)
VITE_COMPANY_NAME=PT Contoh Distribusi
VITE_COMPANY_ADDRESS=Jl. Contoh No. 1, Jember, Jawa Timur
VITE_COMPANY_PHONE=(0331) 000-000
VITE_COMPANY_BANK=Bank Contoh 000-000-0000 a.n. PT Contoh Distribusi
